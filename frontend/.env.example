# Optional. Leave unset during `npm run dev` to use the Vite proxy (avoids CORS).
# VITE_DEV_API_PROXY=http://localhost:8000
#
# For `vite preview` or production, set your API origin, e.g.:
# VITE_API_URL=https://api.example.com
#
# FastAPI analytics (port 8000). Dev uses Vite proxy when unset:
# VITE_ANALYTICS_URL=http://localhost:8000
# VITE_DEV_ANALYTICS_PROXY=http://localhost:8000
