# Cognito — JWKS verification (/protected) + /auth routes
COGNITO_REGION=eu-central-1
COGNITO_USER_POOL_ID=your-pool-id
# App client ID (must match ID token "aud" when verifying audience)
COGNITO_APP_CLIENT_ID=your-app-client-id
# Or: COGNITO_CLIENT_ID=...

# Optional — only if the app client has a client secret (confidential client).
# Omit for public SPA clients (no secret).
# COGNITO_CLIENT_SECRET=

# Optional: extra allowed browser origins (comma-separated). Localhost + 127.0.0.1:5173
# are always allowed for Vite. Add production URL when you deploy, e.g.:
# FRONTEND_ORIGIN=https://app.example.com,https://www.example.com

# Avoid 5000 on macOS — AirPlay Receiver often uses it and breaks API POSTs with 403.
PORT=5050
