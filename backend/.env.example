# PostgreSQL
# DATABASE_URL=postgresql://user:password@localhost:5432/bundesdata

# JWT
# SECRET_JWT_KEY=
# ACCESS_TOKEN_EXPIRE_MINUTES=15
# REFRESH_TOKEN_EXPIRE_DAYS=15
# TOKEN_ALGORITHM=HS256

# Redis (login rate limit)
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_DB=0
# RATE_LIMIT_ATTEMPTS=5
# RATE_LIMIT_EXPIRE=600

# Set to 1 to skip JWT on match routes (local parquet demos only)
SKIP_AUTH=0

# Football API (optional — team logos / player photos)
# FOOTBALL_API_KEY=
